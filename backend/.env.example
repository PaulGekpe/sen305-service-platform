# Copy to backend/.env (which is git-ignored) and fill in your own values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use MySQL 8 for the course project. Leave DB_ENGINE unset to fall back to SQLite.
DB_ENGINE=mysql
DB_NAME=sen305_service_platform
DB_USER=sen305_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
